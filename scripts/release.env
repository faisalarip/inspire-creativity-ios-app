# Release gate configuration — NON-SECRET. Secrets never live in this file.
# Read by Tools/asc_release.py (submit) and the /release command.
#
# AUTO_SUBMIT=true   After the Xcode Cloud build is processed and release
#                    validation passes, `Tools/asc_release.py submit` proceeds
#                    to App Review WITHOUT a per-release confirmation. This is
#                    the standing authorization required by the release gate.
# AUTO_SUBMIT=false  The release flow stops at the gate and reports
#                    "WAITING FOR AUTHORIZATION"; submit then requires the
#                    explicit flag:  Tools/asc_release.py submit --authorize
#
# Note: a plain `git push origin release` only builds + uploads to TestFlight.
# App Review submission happens ONLY through the /release flow or an explicit
# `asc_release.py submit` — never as a side effect of a push.
AUTO_SUBMIT=true
